# Local development. Copy to `.env` (which is git-ignored). Leave MONGODB_URI
# and NEWS_API_KEY blank to run fully offline — the dashboard then shows
# clearly-badged SIMULATED demo data (never in production).
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
MONGODB_URI=
NEWS_API_KEY=
ENABLE_LIVE_PRICE_API=false
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info
