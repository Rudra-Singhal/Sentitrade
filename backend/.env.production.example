# Production. Set these in the host dashboard (Render), never commit real values.
# In production the server REFUSES to start without MONGODB_URI and a client URL,
# and it never substitutes simulated data — missing data renders as "unavailable".
NODE_ENV=production
PORT=3000
CLIENT_URL=https://your-frontend-domain.vercel.app
FRONTEND_URL=https://your-frontend-domain.vercel.app
# Use a generated password and a least-privilege database user. Restrict Atlas
# network access to your host's egress IPs — do NOT leave it open to 0.0.0.0/0.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sentiment-dashboard
NEWS_API_KEY=your_newsapi_key
FINNHUB_API_KEY=
ENABLE_LIVE_PRICE_API=true
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info
SENTRY_DSN=

STOCKTWITS_TOKEN=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

TWITTER_BEARER_TOKEN=
TWITTERAPI_IO_KEY=
